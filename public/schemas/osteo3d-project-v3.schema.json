{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jj-martinez-garcia.github.io/ArchaeOsteo/schemas/osteo3d-project-v3.schema.json",
  "title": "Osteo3D project",
  "description": "Versioned interchange contract for an Osteo3D local project. Scientific observations remain user-entered data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "projectName", "schemaVersion", "profile", "selected"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "projectName": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "profile": { "enum": ["adult_male", "adult_female", "infant", "neonate"] },
    "selected": { "type": "string", "minLength": 1 },
    "skeletonFilter": { "enum": ["all", "axial", "appendicular"] },
    "regionFilter": { "type": "string" },
    "explosion": { "type": "number", "minimum": 0, "maximum": 100 },
    "tableMode": { "type": "boolean" },
    "orthographic": { "type": "boolean" },
    "isolate": { "type": "boolean" },
    "wireframe": { "type": "boolean" },
    "xray": { "type": "boolean" },
    "colorByRegion": { "type": "boolean" },
    "dental3d": { "type": "boolean" },
    "dentitionType": { "enum": ["permanent", "deciduous"] },
    "geometryMode": { "enum": ["auto", "schematic"] },
    "renderQuality": { "enum": ["auto", "low", "high"] },
    "opacityScope": { "enum": ["bone", "region", "skeleton"] },
    "labelMode": { "enum": ["selected", "region", "all", "none"] },
    "comparisonProfile": { "type": "string" },
    "lightIntensity": { "type": "number", "minimum": 0.2, "maximum": 2 },
    "ambientLightIntensity": { "type": "number", "minimum": 0, "maximum": 2 },
    "lightingAzimuth": { "type": "number", "minimum": 0, "maximum": 360 },
    "lightingElevation": { "type": "number", "minimum": 10, "maximum": 90 },
    "lightingMode": { "enum": ["neutral", "laboratory", "high_contrast"] },
    "language": { "enum": ["es", "en"] },
    "updatedAt": { "type": "string" },
    "cameraView": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["theta", "phi", "radius", "target"],
      "properties": {
        "theta": { "type": "number" },
        "phi": { "type": "number", "minimum": 0.12, "maximum": 3.021592653589793 },
        "radius": { "type": "number", "minimum": 0.35, "maximum": 40 },
        "target": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3, "items": false }
      }
    },
    "status": { "$ref": "#/$defs/map" },
    "preservation": { "$ref": "#/$defs/map" },
    "completeness": { "$ref": "#/$defs/map" },
    "fragments": { "$ref": "#/$defs/map" },
    "weights": { "$ref": "#/$defs/map" },
    "weightUnits": { "$ref": "#/$defs/map" },
    "portions": { "$ref": "#/$defs/object" },
    "portionRecords": { "$ref": "#/$defs/object" },
    "developmentRecords": { "$ref": "#/$defs/object" },
    "hierarchyRefs": { "$ref": "#/$defs/object" },
    "individuals": { "$ref": "#/$defs/map" },
    "specimens": { "$ref": "#/$defs/map" },
    "specimenRecords": { "$ref": "#/$defs/object" },
    "ue": { "$ref": "#/$defs/map" },
    "taphonomy": { "$ref": "#/$defs/object" },
    "pathology": { "$ref": "#/$defs/object" },
    "taphonomyDetails": { "$ref": "#/$defs/object" },
    "pathologyDetails": { "$ref": "#/$defs/object" },
    "notes": { "$ref": "#/$defs/map" },
    "indeterminateFragments": { "type": "array" },
    "locked": { "$ref": "#/$defs/map" },
    "hidden": { "$ref": "#/$defs/map" },
    "opacity": { "$ref": "#/$defs/map" },
    "tableTransforms": { "$ref": "#/$defs/object" },
    "customModels": { "$ref": "#/$defs/object" },
    "dental": { "$ref": "#/$defs/map" },
    "deciduousDental": { "$ref": "#/$defs/map" },
    "measurements": { "$ref": "#/$defs/object" },
    "landmarks": { "$ref": "#/$defs/object" },
    "calibrations": { "$ref": "#/$defs/object" },
    "landmarkModelRefs": { "$ref": "#/$defs/object" },
    "photos": { "$ref": "#/$defs/object" },
    "analysisReview": { "$ref": "#/$defs/object" },
    "changeLog": { "type": "array" },
    "filters": { "$ref": "#/$defs/object" },
    "report": { "$ref": "#/$defs/object" },
    "hierarchy": { "$ref": "#/$defs/object" }
  },
  "$defs": {
    "object": { "type": "object" },
    "map": { "type": "object", "additionalProperties": true }
  }
}
